PORT=4000

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Option A — Local MongoDB (requires MongoDB installed locally):
MONGODB_URI=mongodb://localhost:27017/nexusweave

# Option B — MongoDB Atlas (comment out Option A and uncomment/fill this):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexusweave?retryWrites=true&w=majority
#
# mongodb+srv:// relies on DNS SRV lookups. If those fail (VPN, misconfigured resolver),
# put the non-SRV Atlas connection string ("Node.js 2.2.12+" option) here as a fallback:
MONGODB_URI_FALLBACK=

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED — the server exits immediately on startup if this is missing.
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_before_use
JWT_EXPIRES_IN=24h

# ── CORS ─────────────────────────────────────────────────────────────────────
# Use * for local development, or your exact deployed origin in production.
CLIENT_ORIGIN=*

# ── Google OAuth (optional) ──────────────────────────────────────────────────
# The OAuth Client ID from https://console.cloud.google.com/
# Leave blank to disable the "Continue with Google" button.
GOOGLE_CLIENT_ID=

# ── MakAI / Groq (optional) ──────────────────────────────────────────────────
# Get a free API key at https://console.groq.com/
# Leave blank — the local Context Engine fallback will still work without it.
GROQ_API_KEY=
