PORT=4000

# Local MongoDB:
#   MONGODB_URI=mongodb://localhost:27017/nexusweave
# MongoDB Atlas — always use the mongodb+srv:// form. The older
# mongodb://host1,host2,host3?replicaSet=... form pins shard hostnames that Atlas
# rotates during maintenance, which breaks the connection with no code change.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexusweave?retryWrites=true&w=majority

# Optional. mongodb+srv:// depends on DNS SRV lookups, which Node performs with its own
# resolver rather than the OS one — that can fail even when normal DNS works. Put the
# non-SRV ("Node.js driver 2.2.12 or later" option in Atlas) string here and the server
# will fall back to it automatically instead of going down.
MONGODB_URI_FALLBACK=

# Required — server will not start without JWT_SECRET
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=24h

# Allowed browser origin. Use * for local development, or your deployed site URL.
CLIENT_ORIGIN=*

GOOGLE_CLIENT_ID=your_google_client_id_here
